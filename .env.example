# ============================================================
#  Copia este archivo como .env y completa los valores reales.
#  NUNCA subas .env a git.
# ============================================================

# ---------- Telegram (lo más rápido para probar) ----------
# Token que te da @BotFather en Telegram (/newbot).
TELEGRAM_BOT_TOKEN=
# polling = el servidor pregunta a Telegram (SIN URL pública, ideal para probar)
# webhook = Telegram llama a /telegram/webhook (necesita HTTPS en producción)
# off     = desactivado
TELEGRAM_MODE=polling
# Solo para modo webhook: se compara con la cabecera X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# ---------- WhatsApp Cloud API (Meta) ----------
# Puedes dejar WhatsApp vacío mientras pruebas con Telegram.
# Token permanente (o temporal de 24 h del panel de Meta).
WA_TOKEN=
# ID del número de teléfono (NO es el número, es el ID numérico).
WA_PHONE_NUMBER_ID=
# Palabra secreta que tú inventas; se repite en el panel de Meta al suscribir el webhook.
WA_VERIFY_TOKEN=mi-token-secreto-de-verificacion
# App Secret de Meta. Si lo dejas vacío NO se valida la firma de los webhooks (solo desarrollo).
WA_APP_SECRET=
WA_API_VERSION=v21.0
# Marca los mensajes como leídos (doble check azul) al recibirlos.
WA_MARK_AS_READ=true

# ---------- Gemini (obligatorio) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.5
GEMINI_MAX_OUTPUT_TOKENS=600
# 0 = respuestas rápidas sin "razonamiento" extra. Vacío o comentado = comportamiento por defecto del modelo.
GEMINI_THINKING_BUDGET=0
# Si GEMINI_MODEL deja de existir, se intenta este antes de fallar. Vacío = desactivado.
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# ---------- Comportamiento del asistente ----------
BUSINESS_NAME=Mi Negocio
# Cuántos mensajes de historial se envían al modelo como contexto.
HISTORY_TURNS=12
# Agrupa mensajes seguidos del cliente (segundos) para no responder 3 veces seguidas. 0 = desactivado.
BUFFER_SECONDS=2
# Se envía cuando el bot transfiere a una persona (se añade al final de la respuesta).
HANDOFF_MESSAGE=Te paso con una persona del equipo para ayudarte mejor. En breve te escribimos por aquí 🙌
# Opcional: webhook (Slack, Telegram, n8n…) que recibe un JSON cuando hay un escalado.
HANDOFF_WEBHOOK_URL=

# ---------- Infraestructura ----------
KNOWLEDGE_PATH=knowledge/negocio.md
DATABASE_PATH=data/bot.db
# Clave para el panel de administración (cabecera X-Admin-Key). Cámbiala.
ADMIN_KEY=cambia-esta-clave
LOG_LEVEL=INFO
# Zona horaria para que el bot sepa qué día es (afecta a "¿están abiertos hoy?").
TIMEZONE=America/Mexico_City
